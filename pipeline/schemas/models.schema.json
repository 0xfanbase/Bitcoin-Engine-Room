{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xfanbase.github.io/Bitcoin-Engine-Room/schemas/models.schema.json",
  "title": "models.json",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "power_law",
    "cycle_overlay",
    "mayer_multiple",
    "wma_200"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "power_law": {
      "type": "object",
      "required": [
        "bands",
        "current",
        "cycle_top_era_maxima_sigma",
        "cycle_tops",
        "params",
        "previous_params",
        "projections",
        "realtime_z",
        "short_term",
        "trend_uncertainty"
      ],
      "properties": {
        "params": {
          "type": "object",
          "required": [
            "a",
            "b",
            "r_squared",
            "sigma",
            "fit_start_date",
            "n_points"
          ],
          "properties": {
            "b": {
              "type": "number"
            },
            "a": {
              "type": "number"
            },
            "r_squared": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "current": {
          "type": "object",
          "required": [
            "date",
            "price",
            "trend_price",
            "deviation_pct",
            "z_score",
            "residual_percentile"
          ]
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "floor",
              "inner_low",
              "trend",
              "inner_high",
              "ceiling",
              "trend_low",
              "trend_high"
            ]
          }
        },
        "cycle_tops": {
          "type": "array",
          "description": "Cycle-top markers, admitted only by a stated mechanical rule (see MODEL_METHODOLOGY.md), each scored against this SAME power-law fit's a/b/sigma -- not an independent curve fit through the tops. 'kind' distinguishes how a point was admitted; two entries may describe the same halving era when different rules disagree about where it topped -- that disagreement is kept visible, not resolved by picking one. Every confirmed:false entry carries drawdown_so_far_pct, computed uniformly regardless of kind.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "price",
              "sigma_vs_trend",
              "kind",
              "confirmed"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sigma_vs_trend": {
                "type": "number"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "confirmed_top",
                  "era_max_sigma",
                  "current_era_high",
                  "unconfirmed_top"
                ]
              },
              "confirmed": {
                "type": "boolean"
              },
              "drawdown_so_far_pct": {
                "type": "number"
              }
            },
            "if": {
              "properties": {
                "confirmed": {
                  "const": false
                }
              }
            },
            "then": {
              "required": [
                "drawdown_so_far_pct"
              ]
            }
          }
        },
        "cycle_top_era_maxima_sigma": {
          "type": "array",
          "description": "Each halving era's own highest sigma_vs_trend value and the date it occurred, oldest first, current (open) era last -- the date is NOT reliably the same as any other cycle_tops entry's date for that era (a confirmed top and the era's peak-sigma reading can fall on different days). Site copy may only claim 'each era topped lower than the last' when the sigma_vs_trend sequence is actually non-increasing; it is an observed pattern in past data, not a guarantee.",
          "items": {
            "type": "object",
            "required": [
              "date",
              "sigma_vs_trend"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "sigma_vs_trend": {
                "type": "number"
              }
            }
          }
        },
        "bands": {
          "type": "object",
          "required": [
            "floor_label",
            "trend_label",
            "ceiling_label",
            "method",
            "outer_offsets_log10",
            "inner_offsets_log10",
            "in_sample_coverage",
            "note"
          ],
          "properties": {
            "outer_offsets_log10": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "inner_offsets_log10": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "trend_uncertainty": {
          "type": "object",
          "required": [
            "method",
            "b_low",
            "b_high",
            "fan"
          ],
          "properties": {
            "fan": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "day",
                  "low",
                  "mid",
                  "high"
                ]
              }
            }
          }
        },
        "scenario": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "label",
                "fit_start_date",
                "a",
                "b",
                "sigma",
                "n_points"
              ]
            }
          ]
        },
        "short_term": {
          "type": "object",
          "required": [
            "method",
            "phi",
            "half_life_days",
            "path"
          ],
          "properties": {
            "path": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "date",
                  "day",
                  "center",
                  "inner_low",
                  "inner_high",
                  "outer_low",
                  "outer_high"
                ]
              }
            }
          }
        },
        "realtime_z": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "z",
              "b"
            ]
          }
        }
      }
    },
    "cycle_overlay": {
      "type": "object",
      "required": [
        "epochs",
        "current_epoch"
      ]
    },
    "mayer_multiple": {
      "type": "object",
      "required": [
        "current",
        "series"
      ]
    },
    "wma_200": {
      "type": "object",
      "required": [
        "current",
        "series"
      ]
    }
  }
}
